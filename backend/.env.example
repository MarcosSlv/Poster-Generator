# Porta do servidor
PORT=3333

# Origens liberadas no CORS, separadas por vírgula.
# Se ficar vazio, todas as origens são aceitas (apenas para desenvolvimento).
# Em produção: https://poster-generator-rose.vercel.app
# Barra final e maiúsculas são ignoradas; o navegador envia a origem sem barra.
CORS_ORIGIN=http://localhost:5173

# Chave da API do Gemini, usada pelo assistente de formatação.
# Gere em https://aistudio.google.com/apikey
# Este arquivo é versionado: a chave real vai no .env, que é ignorado pelo Git.
# Sem ela a aba "Assistente" responde 503 e o resto do sistema segue normal.
GEMINI_API_KEY=

# Modelo usado pelo assistente (opcional).
# O padrão é um alias que acompanha a versão estável mais nova do Flash Lite.
# Fixe uma versão (ex.: gemini-3.5-flash-lite) se quiser controle sobre quando muda.
GEMINI_MODEL=gemini-flash-lite-latest
